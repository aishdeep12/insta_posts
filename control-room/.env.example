# Copy this file to .env and edit. Nothing else needs to change to swap models.

PORT=8787
HOST=127.0.0.1

# ---- Model (the only thing you change to go cheaper) ----
# ollama     local models, free:        LLM_BASE_URL=http://127.0.0.1:11434   LLM_MODEL=llama3.1:8b
# openai     any OpenAI-compatible API: LLM_BASE_URL=https://api.openai.com/v1  (LM Studio: http://127.0.0.1:1234/v1)
# anthropic  Claude API:                LLM_BASE_URL=https://api.anthropic.com
# mock       no model, for tests
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=

# ---- Live trend search for Trend Scout (optional) ----
# brave or tavily. Leave empty to use the built-in Oct 2026 sweep in the UI.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---- Publishing (optional) ----
# DRY_RUN=1 renders the slides and writes the payload to data/out/ but posts nothing.
DRY_RUN=1
ACCOUNT_HANDLE=analytunb
# Instagram Graph API: a Business or Creator account linked to a Facebook Page, an app with
# instagram_content_publish, and a long-lived access token. Keep this file private.
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v21.0
# Slides must be at public https links. The server pushes them to your GitHub repo clone:
IG_REPO_DIR=
IG_RAW_BASE=https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main
